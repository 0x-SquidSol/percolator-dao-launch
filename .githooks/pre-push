#!/bin/sh
# Leak guard, provenance guard and secret scan for everything about to be
# pushed: ref names, and every commit's identities, message, file names and
# contents, including
# commits made by merges and rebases, which skip the pre-commit hook.
# See scripts/README.md.
. "$(dirname "$0")/find-python.sh"
# Read the real objects a commit or push uses, not `git replace` stand-ins
# (this also reaches gitleaks, which reads through git).
export GIT_NO_REPLACE_OBJECTS=1

if ! command -v gitleaks >/dev/null 2>&1; then
  echo "secret scan: gitleaks is required for pushes (see scripts/README.md)" >&2
  exit 1
fi

# git passes one "<local ref> <local sha> <remote ref> <remote sha>" line per
# ref. Both checks need it, so keep a copy.
updates=$(cat)

printf '%s\n' "$updates" | "$PY" scripts/guards/guard.py pre-push || exit 1

zero=0000000000000000000000000000000000000000
printf '%s\n' "$updates" | while read -r local_ref local_sha remote_ref remote_sha; do
  [ -n "$local_sha" ] || continue
  [ "$local_sha" = "$zero" ] && continue  # deleting a ref: nothing to scan
  if [ "$remote_sha" = "$zero" ]; then
    # New ref: check all of its history, as guard.py does. Local tracking
    # refs can't be trusted to say what the remote already has (another
    # remote's refs, stale or hand-made refs).
    range="$local_sha"
  else
    # Existing ref: git passes the remote's real tip, so only new commits.
    range="$remote_sha..$local_sha"
  fi
  # $range is unquoted on purpose: it may be a two-dot range of commit IDs.
  "$PY" scripts/guards/provenance.py commits $range || exit 1
  gitleaks git --config .gitleaks.toml --redact --no-banner \
    --log-opts="$range" . || exit 1
done
