{
  "compilerOptions": {
    "types": ["mocha", "chai", "node"],
    "lib": ["es2020"],
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "target": "ES2020",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "noEmit": true
  },
  "include": ["tests/**/*.ts", "scripts/**/*.ts"]
}
